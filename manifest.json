{
  "manifest_version": 3,
  "name": "GameGuard – 3D Game Blocker",
  "description": "Blocks 3D browser games (WebGL / WebGPU and known 3D game sites). Unlock with the admin password.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GameGuard",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "ui.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}